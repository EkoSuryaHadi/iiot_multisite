# Contoh konfigurasi Garage (S3-compatible) — TANPA secret.
# Salin ke garage.toml lalu isi rpc_secret & admin_token dengan hasil:
#   openssl rand -hex 32        -> rpc_secret
#   openssl rand -base64 24     -> admin_token
# garage.toml TIDAK di-commit (sudah masuk .gitignore).
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "<64 hex chars>"

[s3_api]
s3_region = "us-east-1"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "<token admin>"
