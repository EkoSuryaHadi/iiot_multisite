# === Domain & Frontend (Next.js + Caddy) ===
# Isi APP_DOMAIN dengan domain publik VPS Anda (misal: iot.perusahaan.com) untuk auto-HTTPS Let's Encrypt,
# atau biarkan ":80" jika diakses langsung via HTTP IP VPS.
APP_DOMAIN=:80
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=change_me_nextauth_secret

# === Bootstrap Superadmin ===
SUPERADMIN_EMAIL=itdev@gaungnusa.com
SUPERADMIN_PASSWORD=change_me_superadmin_password

# === Postgres (Device & User Mgmt) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iiot
POSTGRES_USER=iiot
POSTGRES_PASSWORD=change_me_postgres

# === ClickHouse ===
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=iiot
CLICKHOUSE_USER=iiot
CLICKHOUSE_PASSWORD=change_me_clickhouse


# === EMQX ===
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=change_me_emqx
EMQX_MQTT_PORT=1883
EMQX_MQTTS_PORT=8883
EMQX_WS_PORT=8083
EMQX_CLUSTER_COOKIE=change_me_emqx_cookie
HAPROXY_STATS_PORT=9100

# === Auth / JWT (dipakai Fase 2 & 3) ===
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=10080

# === Auth Webhook (EMQX authn/authz) ===
AUTH_WEBHOOK_CACHE_TTL_SECONDS=30
INTERNAL_SERVICE_USERNAME=internal-service
INTERNAL_SERVICE_PASSWORD=change_me_internal_service_password

# === Ingest Secret (EMQX Rule Engine -> Analytics API) ===
INGEST_SECRET=change_me_ingest_secret

# === Service ports (host - dipakai di docker-compose.yml dev) ===
DEVICE_MGMT_PORT=8001
AUTH_WEBHOOK_PORT=8002
ANALYTICS_API_PORT=8003
